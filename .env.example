# ───────────────────────────────────────────────
# SmartBcChopp ERP — Environment Configuration
# ───────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Production: run scripts/setup.sh to auto-generate secrets.
# ───────────────────────────────────────────────

# --- Application ---
APP_NAME=SmartBcChopp ERP
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=["https://seu-dominio.com"]

# --- Logging ---
# "text" for human-readable, "json" for production/structured
LOG_FORMAT=json

# --- Database ---
DATABASE_URL=postgresql+asyncpg://smartbcchopp:senha@postgres:5432/smartbcchopp
DATABASE_SYNC_URL=postgresql://smartbcchopp:senha@postgres:5432/smartbcchopp

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- WhatsApp / Evolution API ---
WHATSAPP_BASE_URL=http://evolution-api:8080
WHATSAPP_API_KEY=seu-whatsapp-api-key
WHATSAPP_INSTANCE=smartbcchopp
WHATSAPP_WEBHOOK_URL=https://seu-dominio.com/api/v1/whatsapp/webhook

# --- External Integrations ---
VIA_CEP_URL=https://viacep.com.br/ws
GOOGLE_MAPS_API_KEY=
NFE_API_KEY=
PAGARME_API_KEY=

# --- Docker Compose (only used by docker-compose.yml) ---
POSTGRES_DB=smartbcchopp
POSTGRES_USER=smartbcchopp
POSTGRES_PASSWORD=senha-forte-aqui
SERVER_NAME=seu-dominio.com
